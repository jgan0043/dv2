                {
                  "Institution": "University of Divinity",
                  "lon": 144.96,
                  "lat": -37.79
                },
                {
                  "Institution": "Victoria University",
                  "lon": 144.9,
                  "lat": -37.79
                },
                {
                  "Institution": "Bond University",
                  "lon": 153.42,
                  "lat": -28.07
                },
                {
                  "Institution": "CQUniversity",
                  "lon": 150.52,
                  "lat": -23.32
                },
                {
                  "Institution": "Griffith University",
                  "lon": 153.05,

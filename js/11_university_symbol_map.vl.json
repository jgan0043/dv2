                  "lon": 150.88,
                  "lat": -34.41
                },
                {
                  "Institution": "Western Sydney University",
                  "lon": 151.0,
                  "lat": -33.81
                },
                {
                  "Institution": "Deakin University",
                  "lon": 145.12,
                  "lat": -37.85
                },
                {
                  "Institution": "Federation University Australia",
                  "lon": 143.89,
                  "lat": -37.63
                },
                {
                  "Institution": "La Trobe University",

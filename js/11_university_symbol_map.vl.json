                {
                  "Institution": "The University of Western Australia",
                  "lon": 115.82,
                  "lat": -31.98
                },
                {
                  "Institution": "Flinders University",
                  "lon": 138.57,
                  "lat": -35.02
                },
                {
                  "Institution": "The University of Adelaide",
                  "lon": 138.6,
                  "lat": -34.92
                },
                {
                  "Institution": "Torrens University Australia",
                  "lon": 138.61,
                  "lat": -34.92
                },
                {
                  "Institution": "University of South Australia",
                  "lon": 138.59,
                  "lat": -34.92
                },
                {
                  "Institution": "University of Tasmania",
                  "lon": 147.33,
                  "lat": -42.9
                },
                {
                  "Institution": "Charles Darwin University",
                  "lon": 130.87,
                  "lat": -12.37
                },
                {
                  "Institution": "The Australian National University",
                  "lon": 149.12,
                  "lat": -35.28
                },
                {
                  "Institution": "University of Canberra",
                  "lon": 149.08,
                  "lat": -35.24
                },
                {
                  "Institution": "Australian Catholic University",
                  "lon": 151.21,
                  "lat": -33.84
                }
              ]
            },
            "key": "Institution",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "filter": "isValid(datum.lon)"
        },
        {
          "calculate": "toNumber(datum['Total(2.01)'])",
          "as": "students"
        },
        {
          "calculate": "replace(replace(replace(datum.Institution, '(1.03)', ''), '(1.09)', ''), 'The University of', 'University of')",
          "as": "name"
        },
        {
          "fold": [
            "Management and Commerce",
            "Society and Culture",
            "Health",
            "Information Technology",
            "Education",
            "Natural and Physical Sciences",
            "Engineering and Related Technologies",
            "Creative Arts",
            "Architecture and Building",
            "Agriculture, Environmental and Related Studies"
          ],
          "as": [
            "official",
            "n"
          ]
        },
        {
          "calculate": "isValid(toNumber(datum.n)) ? toNumber(datum.n) : 0",
          "as": "n"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "r"
            }
          ],
          "groupby": [
            "Institution"
          ],
          "sort": [
            {
              "field": "n",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.r === 1"
        },
        {
          "lookup": "official",
          "from": {
            "data": {
              "values": [
                {
                  "official": "Management and Commerce",
                  "field": "Business"
                },
                {
                  "official": "Society and Culture",
                  "field": "Society & Culture"
                },
                {
                  "official": "Health",
                  "field": "Health"
                },
                {
                  "official": "Information Technology",
                  "field": "IT"
                },
                {
                  "official": "Education",
                  "field": "Education"
                },
                {
                  "official": "Natural and Physical Sciences",
                  "field": "Science"
                },
                {
                  "official": "Engineering and Related Technologies",
                  "field": "Engineering"
                },
                {
                  "official": "Creative Arts",
                  "field": "Creative Arts"
                },
                {
                  "official": "Architecture and Building",
                  "field": "Architecture"
                },
                {
                  "official": "Agriculture, Environmental and Related Studies",
                  "field": "Agriculture"
                }
              ]
            },
            "key": "official",
            "fields": [
              "field"
            ]
          }
        },
        {
          "calculate": "datum.n / datum.students",
          "as": "leadShare"
        },
        {
          "calculate": "indexof(['Health', 'Business', 'Society & Culture'], datum.field) >= 0 ? datum.field : 'Another field'",
          "as": "lead"
        }
      ],
      "params": [
        {
          "name": "pick",
          "select": {
            "type": "point",
            "fields": [
              "lead"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#fcfcfb",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "students",
          "type": "quantitative",
          "title": "Students (2024)",
          "scale": {
            "range": [
              12,
              1100
            ]
          },
          "legend": {
            "values": [
              10000,
              40000,
              80000
            ],
            "labelExpr": "format(datum.value, ',')",
            "orient": "right",
            "symbolFillColor": "#cfcdc4",
            "symbolStrokeWidth": 0
          }
        },
        "color": {
          "field": "lead",
          "type": "nominal",
          "title": "Largest field",
          "scale": {
            "domain": [
              "Health",
              "Business",
              "Society & Culture",
              "Another field"
            ],
            "range": [
              "#2a78d6",
              "#eb6834",
              "#1baf7a",
              "#bdbbb2"
            ]
          },
          "legend": {
            "orient": "right",
            "symbolType": "circle",
            "symbolSize": 120
          }
        },
        "opacity": {
          "condition": {
            "param": "pick",
            "value": 0.78
          },
          "value": 0.1
        },
        "order": {
          "field": "students",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "University"
          },
          {
            "field": "State"
          },
          {
            "field": "students",
            "type": "quantitative",
            "title": "Students (2024)",
            "format": ","
          },
          {
            "field": "field",
            "title": "Largest field"
          },
          {
            "field": "leadShare",
            "type": "quantitative",
            "title": "Share in largest field",
            "format": ".0%"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 113.4,
            "lat": -36.6,
            "t": "Most of the largest universities",
            "t2": "are in Sydney and Melbourne"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "text",
            "align": "left",
            "fontStyle": "italic"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "fontStyle": "italic",
            "dy": 15
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "t2"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "background": "#fcfcfb",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "padding": 12,
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "start",
      "fontSize": 19,
      "fontWeight": 700,
      "color": "#0b0b0b",
      "subtitleFontSize": 13,
      "subtitleColor": "#52514e",
      "subtitlePadding": 6,
      "offset": 16
    },
    "axis": {
      "labelColor": "#52514e",
      "labelFontSize": 12,
      "titleColor": "#52514e",
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "gridColor": "#e1e0d9",
      "domainColor": "#c3c2b7",
      "tickColor": "#c3c2b7"
    },
    "legend": {
      "labelColor": "#52514e",
      "labelFontSize": 12,
      "titleColor": "#52514e",
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "header": {
      "labelColor": "#0b0b0b",
      "labelFontSize": 13,
      "labelFontWeight": 600,
      "titleFontSize": 0
    },
    "text": {
      "fontSize": 12,
      "color": "#52514e"
    },
    "line": {
      "strokeWidth": 2
    }
  }
}

                  "lat": -37.72
                },
                {
                  "Institution": "Monash University",
                  "lon": 145.13,
                  "lat": -37.91
                },
                {
                  "Institution": "RMIT University",
                  "lon": 144.96,
                  "lat": -37.81
                },
                {
                  "Institution": "Swinburne University of Technology",
                  "lon": 145.04,

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 11 (proportional symbol map). Students enrolled at each of Australia's 42 universities in 2024 (circle area) and the field with the most students at that university (colour). Source: Department of Education, Higher Education Statistics 2024, Section 2 All Students, Table 2.10. Campus locations are approximate main campuses. Boundaries: ABS ASGS states, simplified.",
  "title": {
    "text": "Australia's Universities and Their Largest Field, 2024",
    "subtitle": [
      "Each circle is a university: size = students enrolled, colour = the field with the most students",
      "Click a colour in the legend to highlight those universities; double-click to reset"
    ]
  },
  "width": 500,
  "height": 430,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topo.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ecebe5",
        "stroke": "#fcfcfb",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "data/2-10_students_by_university_and_field.csv"
      },
      "transform": [
        {
          "lookup": "Institution",
          "from": {
            "data": {
              "values": [
                {
                  "Institution": "Avondale University",
